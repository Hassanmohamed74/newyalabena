import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Lead } from '../../shared/entities/lead.entity';

@Injectable()
export class LeadsService {
  constructor(
    @InjectRepository(Lead)
    private readonly repo: Repository<Lead>,
  ) {}

  async findAll() {
    return this.repo.find({
      relations: ['branch', 'assigned_agent'],
      order: { created_at: 'DESC' } as any,
    });
  }

  async findOne(id: string) {
    const lead = await this.repo.findOne({
      where: { id },
      relations: ['branch', 'assigned_agent'],
    });

    if (!lead) {
      throw new NotFoundException(`Lead with ID ${id} not found`);
    }

    return lead;
  }

  async create(createDto: any) {
    const newLead = this.repo.create(createDto);
    return await this.repo.save(newLead);
  }

  async update(id: string, updateDto: any) {
    await this.findOne(id);
    await this.repo.update(id, updateDto);
    return this.findOne(id);
  }
}
