import { Controller, Get, Post, Put, Delete, Param, Body, Query } from '@nestjs/common';
import { ApiTags, ApiOperation, ApiResponse, ApiBearerAuth, ApiQuery, ApiBody, ApiParam } from '@nestjs/swagger';
import { InventoryItemsService } from './inventory.service';
import { InventoryItem } from '../../shared/entities/inventory-item.entity';

@ApiTags('Inventory')
@ApiBearerAuth('JWT')
@Controller('inventory')
export class InventoryItemsController {
  constructor(private readonly service: InventoryItemsService) {}

  @Post()
  @ApiOperation({ summary: 'Create a new inventory item (books, workbooks, merchandise)' })
  @ApiBody({ 
    description: 'Inventory item creation payload',
    schema: {
      type: 'object',
      properties: {
        name: { type: 'string', example: 'English Level 1 Workbook' },
        sku: { type: 'string', example: 'ENG-WB-01' },
        quantity: { type: 'number', example: 50 },
        unit_price: { type: 'number', example: 250 },
        branchId: { type: 'string', example: '123e4567-e89b-12d3-a456-426614174000' },
        category: { type: 'string', example: 'Books' },
      },
      required: ['name', 'quantity', 'unit_price', 'branchId']
    }
  })
  @ApiResponse({ status: 201, description: 'Inventory item created successfully.' })
  async create(@Body() createData: Partial<InventoryItem>) {
    return this.service.create(createData);
  }

  @Get()
  @ApiOperation({ summary: 'Get all inventory items with optional branch filter' })
  @ApiQuery({ name: 'branchId', required: false, description: 'Filter inventory by branch' })
