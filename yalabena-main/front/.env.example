# Vite Environment Variables (all public, prefixed with VITE_)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Speak Up Academy TMS

# Optional: absolute Socket.IO namespace URL for deployments where the frontend and API use different origins.
# Example: VITE_CHAT_WS_URL=https://api.example.com/chat
# Leave unset for same-origin deployments (the /socket.io proxy handles transport).
