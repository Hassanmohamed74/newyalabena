# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Academy business-calendar time zone (session dates/times are wall-clock
# values in this zone; used by attendance, dashboards and scheduling).
APP_TIME_ZONE=Africa/Cairo

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=speakup_tms
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Integrations (Stage 2+)
# ZOOM_API_KEY and ZOOM_API_SECRET are no longer used by sessions —
# Zoom links are entered manually per group in the UI (zoom_link field).
# ZOOM_API_KEY=
# ZOOM_API_SECRET=
# ZOOM_WEBHOOK_SECRET=
# ONMEET_API_KEY=
# ONMEET_API_URL=
EASYKASH_API_KEY=
EASYKASH_API_URL=
EASYKASH_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@speakup-academy.com
